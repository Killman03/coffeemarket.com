# Copy to .env for local PostgreSQL development; use runtime secrets on a server.
# Add your own database credentials. Do not use this sample unchanged in production.
STORAGE_DRIVER=postgres
DATABASE_URL=postgresql://coffee_app@127.0.0.1:5432/coffee_market
SITE_ORIGIN=http://127.0.0.1:3000
PG_POOL_MAX=10

# Optional separate DDL credential, used by Drizzle Kit only:
# MIGRATION_DATABASE_URL=postgresql://coffee_migrator@127.0.0.1:5432/coffee_market
# Public production origin must be HTTPS. PostgreSQL TLS is configured by the
# standard pg connection string (e.g. sslmode=verify-full and a trusted CA).
# To enable owner sign-in, generate a random secret, e.g.:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# BETTER_AUTH_SECRET=
# Without BETTER_AUTH_SECRET the public calculator works, but admin is closed.
# Provisioning commands require a separate operator-only connection:
# ADMIN_DATABASE_URL=postgresql://coffee_admin@127.0.0.1:5432/coffee_market
# Keep ADMIN_DATABASE_URL out of the application's runtime environment.
# Telegram remains disabled until the manager and business bot are configured.
# Never put credentials in NEXT_PUBLIC_* variables or commit a real .env file.
