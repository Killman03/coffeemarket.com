{
  "name": "coffee-market-calculator",
  "version": "2.2.0",
  "private": true,
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "dev:portable": "next dev --hostname 127.0.0.1",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:portable": "next build && node scripts/prepare-standalone.mjs",
    "start:portable": "node --env-file-if-exists=.env .next-node/standalone/server.js",
    "format": "prettier --write src app ARCHITECTURE.md DEPLOYMENT.md README.md",
    "build:widget": "vite build --config vite.widget.config.ts && node scripts/prepare-widget.mjs",
    "db:generate": "drizzle-kit generate",
    "db:postgres:generate": "drizzle-kit generate --config drizzle.postgres.config.ts",
    "db:postgres:check": "drizzle-kit check --config drizzle.postgres.config.ts",
    "db:postgres:migrate": "drizzle-kit migrate --config drizzle.postgres.config.ts",
    "admin:create": "tsx scripts/admin.ts create",
    "admin:reset-password": "tsx scripts/admin.ts reset-password",
    "admin:revoke-sessions": "tsx scripts/admin.ts revoke-sessions",
    "test:postgres": "vitest run --config vitest.postgres.config.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.27",
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "@hookform/resolvers": "^5.7.1",
    "better-auth": "1.7.27",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.4",
    "exceljs": "4.4.0",
    "libphonenumber-js": "^1.13.16",
    "lucide-react": "^1.31.0",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.85.0",
    "recharts": "^3.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/workers-types": "5.20261109.1",
    "@inquirer/prompts": "8.8.0",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.37",
    "dotenv": "17.4.2",
    "drizzle-kit": "^0.31.7",
    "jsdom": "^26.1.0",
    "json-rpc-2.0": "1.7.1",
    "prettier": "^3.6.2",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.4.4",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "wrangler": "4.156.1"
  },
  "type": "module",
  "overrides": {
    "fflate": "0.7.5",
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
